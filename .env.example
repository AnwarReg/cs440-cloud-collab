# CS 440 Collaborative Development Environment Reference

# Backend Settings
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Settings (Local / Docker Compose)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=cs440_collab

# MySQL Cloud URL (e.g. Railway MySQL)
# DATABASE_URL=mysql://root:password@containers.railway.app:3306/railway

# Frontend Settings
# In production on Vercel/Netlify, set this to your Railway Backend API URL:
# VITE_API_URL=https://cs440-collab-backend.up.railway.app
